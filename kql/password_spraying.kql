IdentityLab_CL
| where EventType == "SignIn"
| where Result == "Failure"
| summarize
    FailedAttempts = count(),
    TargetedUsers = dcount(UserPrincipalName),
    TargetUserList = make_set(UserPrincipalName),
    FirstAttempt = min(TimeGenerated),
    LastAttempt = max(TimeGenerated)
    by SourceIPAddress,
       TimeWindow = bin(TimeGenerated, 15m)
| where FailedAttempts >= 5 and TargetedUsers >= 3
| extend TimeGenerated = LastAttempt
| project
    TimeGenerated,
    SourceIPAddress,
    TimeWindow,
    FailedAttempts,
    TargetedUsers,
    TargetUserList,
    FirstAttempt,
    LastAttempt
| sort by FailedAttempts desc
