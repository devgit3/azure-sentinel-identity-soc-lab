let PasswordSprayTest =
    IdentityLab_CL
    | where Scenario == "Normal Activity"
    | where EventType == "SignIn"
    | where Result == "Failure"
    | summarize
        FailedAttempts = count(),
        TargetedUsers = dcount(UserPrincipalName)
       
    
        by SourceIPAddress,
           TimeWindow = bin(TimeGenerated, 15m)
    | where FailedAttempts >= 5 and TargetedUsers >= 3
    | summarize Detections = count()
    | extend Test = "Password spraying";

let RapidLocationTest =
    IdentityLab_CL
    | where Scenario == "Normal Activity"
    | where EventType == "SignIn"
    | where Result == "Success"
    | sort by UserPrincipalName asc, TimeGenerated asc
    | serialize
    | extend
        PreviousUser = prev(UserPrincipalName),
        PreviousTime = prev(TimeGenerated),
        PreviousCountry = prev(Country)
    | where UserPrincipalName == PreviousUser
    | extend MinutesBetween =
        datetime_diff("minute", TimeGenerated, PreviousTime)
    | where Country != PreviousCountry
    | where MinutesBetween between (0 .. 60)
    | summarize Detections = count()
    | extend Test = "Rapid location change";

let PrivilegeEscalationTest =
    IdentityLab_CL
    | where Scenario == "Normal Activity"
    | where EventType == "Audit"
    | where OperationName == "Add member to role"
    | where Result == "Success"
    | where IsApprovedChange == false
    | summarize Detections = count()
    | extend Test = "Privilege escalation";

union
    PasswordSprayTest,
    RapidLocationTest,
    PrivilegeEscalationTest
| project Test, Detections
| sort by Test asc

